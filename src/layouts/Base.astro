---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site } from '../data/site';
import { organizacion } from '../data/seo';
import { ruta, sinBase } from '../lib/rutas';

interface Props {
  titulo: string;
  descripcion?: string;
  /** El home usa header transparente sobre el hero oscuro */
  headerTransparente?: boolean;
  /** Excluir de buscadores (páginas privadas o de maqueta) */
  noindex?: boolean;
  /** Imagen para redes sociales, relativa al dominio */
  imagen?: string;
  /** Datos estructurados adicionales de la página */
  jsonLd?: Record<string, unknown>[];
}

const {
  titulo,
  descripcion = site.descripcion,
  headerTransparente = false,
  noindex = false,
  imagen = '/og.jpg',
  jsonLd = [],
} = Astro.props;

// sinBase: en un subdirectorio el pathname del home es '/QuualityWebPage/',
// no '/'. Sin descontar la base, el home no se reconocía como tal y el título
// terminaba repitiendo el nombre de la empresa dos veces.
const esHome = sinBase(Astro.url.pathname) === '/';

/**
 * Google corta el título alrededor de los 60 caracteres. Si el nombre completo
 * de la empresa no cabe, se usa la forma corta antes que perder el tema de la
 * página, que es lo que de verdad se busca.
 */
const LIMITE = 62;
function componerTitulo(base: string) {
  if (esHome) return `${site.nombre} — ${site.tagline}`;
  const largo = `${base} | ${site.nombre}`;
  if (largo.length <= LIMITE) return largo;
  const corto = `${base} | ${site.nombreCorto}`;
  return corto.length <= LIMITE ? corto : base;
}
const tituloCompleto = componerTitulo(titulo);

// Astro.site viene de astro.config.mjs. El fallback evita que falle `astro dev`
// si alguien lo quita.
const base = Astro.site ?? new URL('https://qualityac.co');

// Con barra final, para que coincida exactamente con lo que emite el sitemap.
// Si canónica y sitemap discrepan, Google recibe dos URL para la misma página.
const rutaCanonica = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonica = new URL(rutaCanonica, base).href;
const imagenAbsoluta = new URL(imagen, base).href;

// Un solo bloque @graph pesa menos y evita entidades duplicadas.
const grafo = {
  '@context': 'https://schema.org',
  '@graph': [
    organizacion(base),
    {
      '@type': 'WebPage',
      '@id': canonica,
      url: canonica,
      name: tituloCompleto,
      description: descripcion,
      inLanguage: 'es-CO',
      isPartOf: {
        '@type': 'WebSite',
        '@id': new URL('/#sitio', base).href,
        url: new URL('/', base).href,
        name: site.nombre,
        inLanguage: 'es-CO',
        publisher: { '@id': new URL('#organizacion', base).href },
      },
    },
    ...jsonLd,
  ],
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />

    {
      noindex || import.meta.env.EN_PAGES ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      )
    }

    <link rel="icon" type="image/png" href={ruta('/favicon.png')} />
    <link rel="apple-touch-icon" href={ruta('/favicon.png')} />
    <meta name="theme-color" content="#013175" />
    <meta name="author" content={site.nombre} />
    <meta name="geo.region" content="CO-CAU" />
    <meta name="geo.placename" content="Popayán" />

    <link rel="sitemap" href={ruta('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:type" content={esHome ? 'website' : 'article'} />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.nombre} — ${site.tagline}`} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenAbsoluta} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(grafo)} is:inline />
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-navy-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
    >
      Saltar al contenido
    </a>

    <Header transparente={headerTransparente} />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <WhatsAppFab />

    <script>
      // Aparición al hacer scroll. IntersectionObserver, sin librerías.
      const objetivos = document.querySelectorAll<HTMLElement>('.reveal');
      if (objetivos.length) {
        const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducido) {
          objetivos.forEach((el) => el.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entradas) => {
              entradas.forEach((e) => {
                if (!e.isIntersecting) return;
                const el = e.target as HTMLElement;
                const retraso = Number(el.dataset.retraso ?? 0);
                setTimeout(() => el.classList.add('is-in'), retraso);
                io.unobserve(el);
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
          );
          objetivos.forEach((el) => io.observe(el));
        }
      }
    </script>
  </body>
</html>
