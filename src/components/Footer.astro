---
import { site } from '../data/site';
import { servicios } from '../data/servicios';

const anio = new Date().getFullYear();
const redesActivas = site.redes.filter((r) => r.url);

const iconos: Record<string, string> = {
  linkedin: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM6 9H2v12h4z M4 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
  facebook: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  instagram: 'M2 8a6 6 0 0 1 6-6h8a6 6 0 0 1 6 6v8a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6z M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4z M17.5 6.5h.01',
  youtube: 'M22.5 6.4a2.8 2.8 0 0 0-2-2C18.8 4 12 4 12 4s-6.8 0-8.5.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1 12a29 29 0 0 0 .5 5.6 2.8 2.8 0 0 0 2 2C5.2 20 12 20 12 20s6.8 0 8.5-.5a2.8 2.8 0 0 0 2-2A29 29 0 0 0 23 12a29 29 0 0 0-.5-5.6z M9.8 15.3 15.5 12 9.8 8.7z',
};
---

<footer class="surface-navy relative overflow-hidden">
  <div class="grid-lines absolute inset-0 opacity-60" aria-hidden="true"></div>

  <div class="wrap relative py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <!-- Marca -->
      <div>
        <img
          src="/brand/logo-dark.webp"
          srcset="/brand/logo-dark.webp 440w, /brand/logo-dark@2x.webp 880w"
          sizes="208px"
          alt={site.nombre}
          width="440"
          height="221"
          loading="lazy"
          class="h-14 w-auto"
        />
        <p class="mt-5 max-w-sm text-[0.95rem] leading-relaxed text-navy-100">
          Consultoría y formación en sistemas de gestión, riesgos, control interno y calidad en salud.
        </p>
        <p class="mt-4 flex items-start gap-2.5 text-sm text-navy-200">
          <svg class="mt-0.5 size-4 shrink-0 text-gold-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" />
          </svg>
          <span>{site.ciudad}<br /><span class="text-navy-300">{site.cobertura}</span></span>
        </p>

        {
          redesActivas.length > 0 && (
            <div class="mt-6 flex gap-2.5">
              {redesActivas.map((r) => (
                <a
                  href={r.url}
                  target="_blank"
                  rel="noopener"
                  aria-label={r.nombre}
                  class="grid size-9 place-items-center rounded-full border border-white/15 text-navy-100 transition-all hover:border-gold-400 hover:text-gold-400"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={iconos[r.icono]} />
                  </svg>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-sm font-bold tracking-wider text-gold-400 uppercase">Consultoría</h3>
        <ul class="mt-5 space-y-3">
          {
            servicios.map((s) => (
              <li>
                <a href={`/servicios/${s.slug}`} class="text-[0.9rem] text-navy-100 transition-colors hover:text-gold-300">
                  {s.tituloCorto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Enlaces -->
      <div>
        <h3 class="text-sm font-bold tracking-wider text-gold-400 uppercase">Navegación</h3>
        <ul class="mt-5 space-y-3">
          {
            site.nav.map((n) => (
              <li>
                <a href={n.href} class="text-[0.9rem] text-navy-100 transition-colors hover:text-gold-300">
                  {n.texto}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/aula/mi-aprendizaje" class="text-[0.9rem] text-navy-100 transition-colors hover:text-gold-300">
              Mi aprendizaje
            </a>
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-sm font-bold tracking-wider text-gold-400 uppercase">Contacto</h3>
        <ul class="mt-5 space-y-5">
          {
            site.contactos.map((c) => (
              <li>
                <p class="text-[0.9rem] font-semibold text-white">{c.nombre}</p>
                <p class="text-xs text-navy-300">{c.cargo}</p>
                <a href={`tel:${c.telefono.replace(/\s/g, '')}`} class="mt-1.5 block text-[0.9rem] text-navy-100 transition-colors hover:text-gold-300">
                  {c.telefono}
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${site.email}`} class="text-[0.9rem] text-navy-100 transition-colors hover:text-gold-300">
              {site.email}
            </a>
          </li>
          <li class="text-xs text-navy-300">{site.horario}</li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-white/10 pt-7 text-xs text-navy-300 md:flex-row md:items-center md:justify-between">
      <p>© {anio} {site.nombre}. Todos los derechos reservados.</p>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/politica-de-privacidad" class="transition-colors hover:text-gold-300">Política de privacidad</a>
        <a href="/terminos" class="transition-colors hover:text-gold-300">Términos y condiciones</a>
        <span class="text-navy-400">Actividad registrada: edición de libros (CIIU 5811)</span>
      </p>
    </div>
  </div>
</footer>
