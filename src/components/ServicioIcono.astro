---
interface Props {
  nombre: 'gestion' | 'riesgos' | 'control' | 'salud' | 'auditoria';
  clase?: string;
}
const { nombre, clase = 'size-6' } = Astro.props;

// Trazos simples, sin relleno: pesan poco y se ven nítidos en cualquier tamaño.
const trazos: Record<Props['nombre'], string[]> = {
  gestion: ['M3 12a9 9 0 0 1 9-9 9 9 0 0 1 6.4 2.7', 'M21 12a9 9 0 0 1-9 9 9 9 0 0 1-6.4-2.7', 'M18.5 3v3h-3', 'M5.5 21v-3h3', 'm9 12 2 2 4-4'],
  riesgos: ['m12 3 9 16H3z', 'M12 9v4', 'M12 17h.01'],
  control: ['M12 2 4 6v6c0 4.5 3.2 8.4 8 10 4.8-1.6 8-5.5 8-10V6z', 'm9 12 2 2 4-4'],
  salud: ['M12 21s-7-4.5-7-9.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 3.5C19 16.5 12 21 12 21z', 'M12 10v4', 'M10 12h4'],
  auditoria: ['M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9', 'M9 3h6v4H9z', 'M8 12h4', 'M8 16h3', 'M17.5 15.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z', 'm20.5 21.5 2 2'],
};
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {trazos[nombre].map((d) => <path d={d} />)}
</svg>
