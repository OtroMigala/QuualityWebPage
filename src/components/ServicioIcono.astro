---
import type { Icono } from '../data/servicios';

interface Props {
  nombre: Icono;
  clase?: string;
}
const { nombre, clase = 'size-6' } = Astro.props;

// Trazos simples, sin relleno: pesan poco y se ven nítidos en cualquier tamaño.
const trazos: Record<Icono, string[]> = {
  // Las cuatro líneas de servicio
  consultoria: ['M3 20h18', 'M6 20V9', 'M11 20V4', 'M16 20v-7', 'M21 20v-4'],
  formacion: ['m3 8 9-4 9 4-9 4z', 'M7 10.5V16c0 1.7 2.2 3 5 3s5-1.3 5-3v-5.5', 'M21 8v6'],
  eventos: ['M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z', 'M3 10h18', 'M8 3v4', 'M16 3v4', 'M10 15h4'],
  edicion: ['M4 19.5V6a2 2 0 0 1 2-2h12v13H6a2 2 0 0 0-2 2z', 'M18 17v4H6a2 2 0 0 1 0-4', 'M9 8h6'],

  // Las cinco áreas de consultoría
  gestion: ['M3 12a9 9 0 0 1 9-9 9 9 0 0 1 6.4 2.7', 'M21 12a9 9 0 0 1-9 9 9 9 0 0 1-6.4-2.7', 'M18.5 3v3h-3', 'M5.5 21v-3h3', 'm9 12 2 2 4-4'],
  riesgos: ['m12 3 9 16H3z', 'M12 9v4', 'M12 17h.01'],
  control: ['M12 2 4 6v6c0 4.5 3.2 8.4 8 10 4.8-1.6 8-5.5 8-10V6z', 'm9 12 2 2 4-4'],
  salud: ['M12 21s-7-4.5-7-9.5A4.5 4.5 0 0 1 12 8a4.5 4.5 0 0 1 7 3.5C19 16.5 12 21 12 21z', 'M12 10v4', 'M10 12h4'],
  auditoria: ['M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9', 'M9 3h6v4H9z', 'M8 12h4', 'M8 16h3', 'M17.5 15.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z', 'm20.5 21.5 2 2'],
};
---

<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {trazos[nombre].map((d) => <path d={d} />)}
</svg>
