---
import { site, whatsappUrl } from '../data/site';

interface Props {
  transparente?: boolean;
}
const { transparente = false } = Astro.props;
const ruta = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---

<header
  id="cabecera"
  data-transparente={transparente ? 'true' : 'false'}
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-all duration-300',
    transparente ? 'bg-transparent' : 'border-b border-slate-line bg-white/90 backdrop-blur-md',
  ]}
>
  <!-- Barra superior de contacto -->
  <div class="hidden border-b border-white/10 bg-navy-900 text-white lg:block">
    <div class="wrap flex h-9 items-center justify-between text-[0.8rem]">
      <div class="flex items-center gap-6">
        <a href={`mailto:${site.email}`} class="flex items-center gap-2 text-navy-100 transition-colors hover:text-gold-300">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" />
          </svg>
          {site.email}
        </a>
        <a href={whatsappUrl()} target="_blank" rel="noopener" class="flex items-center gap-2 text-navy-100 transition-colors hover:text-gold-300">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
          </svg>
          {site.contactos[0].telefono}
        </a>
      </div>
      <p class="text-navy-200">{site.horario}</p>
    </div>
  </div>

  <!-- Navegación -->
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label={`${site.nombre} — Inicio`}>
      <img
        id="logo-claro"
        src="/brand/logo.webp"
        srcset="/brand/logo.webp 440w, /brand/logo@2x.webp 880w"
        sizes="176px"
        alt={site.nombre}
        width="440"
        height="221"
        class:list={['h-11 w-auto md:h-12', transparente && 'hidden']}
      />
      <img
        id="logo-oscuro"
        src="/brand/logo-dark.webp"
        srcset="/brand/logo-dark.webp 440w, /brand/logo-dark@2x.webp 880w"
        sizes="176px"
        alt={site.nombre}
        width="440"
        height="221"
        class:list={['h-11 w-auto md:h-12', !transparente && 'hidden']}
      />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            data-nav
            aria-current={activo(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-4 py-2 text-[0.9rem] font-medium transition-colors',
              transparente ? 'text-white/85 hover:text-white' : 'text-slate-body hover:text-navy-600',
              activo(item.href) && (transparente ? 'text-white' : 'text-navy-600'),
            ]}
          >
            {item.texto}
            {activo(item.href) && (
              <span class="absolute inset-x-4 -bottom-0.5 h-0.5 rounded-full bg-gold-400" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="/aula" class="btn btn-gold hidden text-sm md:inline-flex"> Aula Virtual </a>

      <button
        id="btn-menu"
        type="button"
        class:list={[
          'grid size-11 place-items-center rounded-full border transition-colors lg:hidden',
          transparente ? 'border-white/25 text-white' : 'border-slate-line text-navy-600',
        ]}
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="menu-movil" hidden class="border-t border-slate-line bg-white lg:hidden">
    <nav class="wrap flex flex-col py-4" aria-label="Navegación móvil">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-lg px-3 py-3 text-base font-medium transition-colors',
              activo(item.href) ? 'bg-navy-50 text-navy-600' : 'text-slate-body hover:bg-slate-bg',
            ]}
          >
            {item.texto}
          </a>
        ))
      }
      <a href="/contacto" class="btn btn-gold mt-3">Solicitar diagnóstico</a>
    </nav>
  </div>
</header>

<script>
  const cabecera = document.getElementById('cabecera')!;
  const esTransparente = cabecera.dataset.transparente === 'true';
  const logoClaro = document.getElementById('logo-claro');
  const logoOscuro = document.getElementById('logo-oscuro');
  const enlaces = cabecera.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const btnMenu = document.getElementById('btn-menu')!;
  const menu = document.getElementById('menu-movil')!;

  // En el home el header nace transparente y se vuelve sólido al bajar
  if (esTransparente) {
    const alScroll = () => {
      const solido = window.scrollY > 40;
      cabecera.classList.toggle('bg-white/95', solido);
      cabecera.classList.toggle('backdrop-blur-md', solido);
      cabecera.classList.toggle('border-b', solido);
      cabecera.classList.toggle('border-slate-line', solido);
      cabecera.classList.toggle('shadow-sm', solido);

      logoClaro?.classList.toggle('hidden', !solido);
      logoOscuro?.classList.toggle('hidden', solido);

      enlaces.forEach((a) => {
        a.classList.toggle('text-white/85', !solido);
        a.classList.toggle('hover:text-white', !solido);
        a.classList.toggle('text-slate-body', solido);
        a.classList.toggle('hover:text-navy-600', solido);
      });
      btnMenu.classList.toggle('border-white/25', !solido);
      btnMenu.classList.toggle('text-white', !solido);
      btnMenu.classList.toggle('border-slate-line', solido);
      btnMenu.classList.toggle('text-navy-600', solido);
    };
    alScroll();
    window.addEventListener('scroll', alScroll, { passive: true });
  }

  btnMenu.addEventListener('click', () => {
    const abierto = menu.hasAttribute('hidden');
    menu.toggleAttribute('hidden', !abierto);
    btnMenu.setAttribute('aria-expanded', String(abierto));
    btnMenu.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  });
</script>
