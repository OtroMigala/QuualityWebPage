---
import Base from '../../../layouts/Base.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import ServicioIcono from '../../../components/ServicioIcono.astro';
import { areas, rutaArea } from '../../../data/servicios';
import { areaLd, migas } from '../../../data/seo';
import { ruta } from '../../../lib/rutas';

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;
const otras = areas.filter((a) => a.slug !== area.slug).slice(0, 3);

const base = Astro.site ?? new URL('https://qualityac.co');
const jsonLd = [
  areaLd(area, base),
  migas(
    [
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Servicios', ruta: '/servicios' },
      { nombre: 'Consultoría organizacional', ruta: '/servicios/consultoria-organizacional' },
      { nombre: area.tituloCorto, ruta: rutaArea(area.slug) },
    ],
    base
  ),
];
---

<Base titulo={area.tituloSeo} descripcion={area.resumen} jsonLd={jsonLd}>
  <!-- Encabezado -->
  <section class="surface-navy relative overflow-hidden pt-40 pb-20 md:pt-48 md:pb-24">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
    <img
      src={ruta('/brand/isotipo.webp')}
      alt=""
      width="256"
      height="282"
      class="pointer-events-none absolute -right-16 -bottom-20 h-80 w-auto opacity-[0.06] brightness-0 invert"
    />

    <div class="wrap relative">
      <nav
        aria-label="Ruta de navegación"
        class="reveal mb-8 flex flex-wrap items-center gap-2 text-[0.82rem] text-navy-200"
      >
        <a href={ruta('/')} class="transition-colors hover:text-gold-300">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href={ruta('/servicios')} class="transition-colors hover:text-gold-300">Servicios</a>
        <span aria-hidden="true">/</span>
        <a href={ruta('/servicios/consultoria-organizacional')} class="transition-colors hover:text-gold-300">
          Consultoría organizacional
        </a>
        <span aria-hidden="true">/</span>
        <span class="text-white">{area.tituloCorto}</span>
      </nav>

      <div class="max-w-3xl">
        <span class="reveal mb-6 grid size-14 place-items-center rounded-2xl bg-white/10 text-gold-400 backdrop-blur-sm">
          <ServicioIcono nombre={area.icono} clase="size-7" />
        </span>
        <h1 class="reveal text-[clamp(1.8rem,4.6vw,3.1rem)] leading-[1.12] font-extrabold" data-retraso="60">
          {area.titulo}
        </h1>
        <p class="reveal mt-4 text-[0.82rem] font-semibold tracking-wide text-gold-300 uppercase" data-retraso="100">
          {area.tagline}
        </p>
        <p class="reveal mt-6 text-[1.05rem] leading-relaxed text-navy-100" data-retraso="140">{area.resumen}</p>
      </div>
    </div>
  </section>

  <!-- Cuerpo -->
  <section class="wrap py-20 md:py-24">
    <div class="grid gap-14 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
      <div>
        <h2 class="reveal text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">En qué consiste</h2>
        <div class="mt-6 space-y-5">
          {
            area.descripcion.map((p, i) => (
              <p class="reveal text-[1.02rem] leading-[1.75] text-slate-body" data-retraso={i * 60}>
                {p}
              </p>
            ))
          }
        </div>

        <h2 class="reveal mt-14 text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">Qué recibe la organización</h2>
        <ul class="mt-7 grid gap-4 sm:grid-cols-2">
          {
            area.entregables.map((e, i) => (
              <li
                class="reveal rounded-xl border border-slate-line bg-slate-bg p-4 text-[0.92rem] leading-relaxed text-slate-body"
                data-retraso={i * 55}
              >
                {e}
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="card reveal p-7">
          <h3 class="text-[1.05rem] font-bold">¿Para quién es?</h3>
          <p class="mt-3.5 text-[0.92rem] leading-relaxed text-slate-body">{area.paraQuien}</p>

          <h3 class="mt-8 text-[1.05rem] font-bold">Marcos de referencia</h3>
          <ul class="mt-3.5 flex flex-wrap gap-2">
            {
              area.normas.map((n) => (
                <li class="rounded-full bg-navy-50 px-3 py-1.5 text-[0.78rem] font-semibold text-navy-600">{n}</li>
              ))
            }
          </ul>

          <a href={ruta('/contacto')} class="btn btn-navy mt-8 w-full">Solicitar propuesta</a>
          <p class="mt-3.5 text-center text-[0.78rem] text-slate-muted">
            Diagnóstico inicial sin costo ni compromiso
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Otras áreas -->
  <section class="bg-slate-bg py-20 md:py-24">
    <div class="wrap">
      <h2 class="reveal text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">Otras áreas de consultoría</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          otras.map((a, i) => (
            <a href={ruta(rutaArea(a.slug))} class="card reveal group p-7" data-retraso={i * 70}>
              <span class="grid size-11 place-items-center rounded-xl bg-navy-50 text-navy-600 transition-colors duration-300 group-hover:bg-navy-600 group-hover:text-gold-400">
                <ServicioIcono nombre={a.icono} clase="size-5" />
              </span>
              <h3 class="mt-4 text-[1rem] leading-snug font-bold">{a.tituloCorto}</h3>
              <p class="mt-2.5 line-clamp-3 text-[0.88rem] leading-relaxed text-slate-body">{a.resumen}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</Base>
