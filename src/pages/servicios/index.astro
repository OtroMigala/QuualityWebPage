---
import Base from '../../layouts/Base.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import ServicioIcono from '../../components/ServicioIcono.astro';
import { servicios } from '../../data/servicios';
import { migas, urlAbsoluta } from '../../data/seo';

const base = Astro.site ?? new URL('https://qualityac.co');
const jsonLd = [
  {
    '@type': 'ItemList',
    name: 'Servicios de consultoría organizacional',
    numberOfItems: servicios.length,
    itemListElement: servicios.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.titulo,
      url: urlAbsoluta(`/servicios/${s.slug}`, base),
    })),
  },
  migas(
    [
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Servicios', ruta: '/servicios' },
    ],
    base
  ),
];
---

<Base
  titulo="Consultoría en sistemas de gestión"
  descripcion="Consultoría ISO 9001, ISO 14001, ISO 45001, gestión de riesgos, control interno, calidad en salud y programas de auditoría. Popayán y todo Colombia."
  jsonLd={jsonLd}
>
  <!-- Encabezado -->
  <section class="surface-navy relative overflow-hidden pt-40 pb-20 md:pt-48 md:pb-24">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative"><div class="max-w-3xl">
      <h1 class="reveal text-[clamp(2rem,5vw,3.4rem)] leading-[1.1] font-extrabold" data-retraso="60">
        Acompañamiento técnico donde su organización lo necesita
      </h1>
      <p class="reveal mt-6 text-[1.05rem] leading-relaxed text-navy-100" data-retraso="120">
        Cinco líneas de trabajo con un mismo criterio: dejar capacidad instalada en su equipo. Cada proyecto se dimensiona
        según el tamaño, la madurez y la exigencia normativa que enfrenta la organización.
      </p>
      </div>
    </div>
  </section>

  <!-- Listado -->
  <section class="wrap py-20 md:py-28">
    <div class="space-y-6">
      {
        servicios.map((s, i) => (
          <article class="card reveal group grid gap-8 p-7 md:grid-cols-[auto_1fr_auto] md:items-center md:p-9" data-retraso={i * 60}>
            <div class="flex items-center gap-5 md:flex-col md:items-start md:gap-3">
              <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-navy-50 text-navy-600 transition-colors duration-300 group-hover:bg-navy-600 group-hover:text-gold-400">
                <ServicioIcono nombre={s.icono} clase="size-7" />
              </span>
              <span class="font-display text-2xl font-extrabold text-navy-400">{s.numero}</span>
            </div>

            <div>
              <h2 class="text-[1.2rem] leading-snug font-bold md:text-[1.35rem]">
                <a href={`/servicios/${s.slug}`} class="transition-colors hover:text-navy-600">
                  {s.titulo}
                </a>
              </h2>
              <p class="mt-2 text-[0.78rem] font-semibold tracking-wide text-gold-600 uppercase">{s.tagline}</p>
              <p class="mt-4 max-w-2xl leading-relaxed text-slate-body">{s.resumen}</p>

              <ul class="mt-5 flex flex-wrap gap-2">
                {s.normas.map((n) => (
                  <li class="rounded-full border border-slate-line bg-slate-bg px-3 py-1 text-[0.75rem] font-medium text-slate-muted">
                    {n}
                  </li>
                ))}
              </ul>
            </div>

            <a href={`/servicios/${s.slug}`} class="btn btn-outline shrink-0 md:self-center">
              Ver detalle
              <svg class="size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</Base>
