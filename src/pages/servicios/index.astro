---
import Base from '../../layouts/Base.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import ServicioIcono from '../../components/ServicioIcono.astro';
import { lineas, areas } from '../../data/servicios';
import { migas, urlAbsoluta } from '../../data/seo';
import { ruta } from '../../lib/rutas';

const base = Astro.site ?? new URL('https://qualityac.co');
const jsonLd = [
  {
    '@type': 'ItemList',
    name: 'Líneas de servicio de Quality Consulting Group',
    numberOfItems: lineas.length,
    itemListElement: lineas.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: l.titulo,
      url: urlAbsoluta(l.href, base),
    })),
  },
  migas(
    [
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Servicios', ruta: '/servicios' },
    ],
    base
  ),
];
---

<Base
  titulo="Servicios"
  descripcion="Consultoría organizacional, formación para el trabajo, organización de eventos y edición de libros. Popayán y todo Colombia."
  jsonLd={jsonLd}
>
  <!-- Encabezado -->
  <section class="surface-navy relative overflow-hidden pt-40 pb-20 md:pt-48 md:pb-24">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative">
      <div class="max-w-3xl">
        <h1 class="reveal text-[clamp(2rem,5vw,3.4rem)] leading-[1.1] font-extrabold" data-retraso="60">
          Cuatro líneas de servicio
        </h1>
        <p class="reveal mt-6 text-[1.05rem] leading-relaxed text-navy-100" data-retraso="120">
          La consultoría es el centro de lo que hacemos, y dentro de ella trabajamos cinco áreas. A su alrededor están
          la formación, la organización de eventos y la actividad editorial.
        </p>
      </div>
    </div>
  </section>

  <!-- Las cuatro líneas -->
  <section class="wrap py-20 md:py-24">
    <div class="grid gap-5 md:grid-cols-2">
      {
        lineas.map((l, i) => (
          <a
            href={ruta(l.href)}
            class="card reveal group flex flex-col p-8 md:p-9"
            data-retraso={i * 70}
          >
            <span class="grid size-14 place-items-center rounded-2xl bg-navy-50 text-navy-600 transition-colors duration-300 group-hover:bg-navy-600 group-hover:text-gold-400">
              <ServicioIcono nombre={l.icono} clase="size-7" />
            </span>

            <h2 class="mt-6 text-[1.3rem] leading-snug font-bold">{l.titulo}</h2>
            <p class="mt-2 text-[0.78rem] font-semibold tracking-wide text-gold-600 uppercase">{l.tagline}</p>
            <p class="mt-4 flex-1 leading-relaxed text-slate-body">{l.resumen}</p>

            {
              l.slug === 'consultoria-organizacional' && (
                <ul class="mt-6 flex flex-wrap gap-2">
                  {areas.map((a) => (
                    <li class="rounded-full border border-slate-line bg-slate-bg px-3 py-1 text-[0.75rem] font-medium text-slate-muted">
                      {a.tituloCorto}
                    </li>
                  ))}
                </ul>
              )
            }

            <span class="mt-7 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-600">
              {
                l.estado === 'en-construccion'
                  ? 'Sección en construcción'
                  : l.slug === 'formacion'
                    ? 'Ir al Aula Virtual'
                    : 'Conocer más'
              }
              <svg
                class="size-4 transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</Base>
