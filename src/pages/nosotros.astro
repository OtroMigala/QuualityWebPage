---
import Base from '../layouts/Base.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { site } from '../data/site';

// ⚠ PENDIENTE: todo el contenido de esta página está a la espera del texto real.
const equipo = [
  { nombre: 'Andrea Cecilia Urbano Gallego', cargo: 'Dirección de Consultoría', iniciales: 'AU' },
  { nombre: 'Gustavo Adolfo Ramírez González', cargo: 'Dirección de Formación', iniciales: 'GR' },
  { nombre: 'Nombre por definir', cargo: 'Consultoría en Salud', iniciales: '—' },
  { nombre: 'Nombre por definir', cargo: 'Auditoría y Riesgos', iniciales: '—' },
];

const valores = [
  ['Rigor técnico', 'Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.'],
  ['Independencia', 'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi.'],
  ['Cercanía', 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum.'],
  ['Transferencia', 'Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia.'],
];
---

<Base titulo="Quiénes somos" descripcion={`${site.nombre} — asesores y consultores en sistemas de gestión.`}>
  <!-- Encabezado -->
  <section class="surface-navy relative overflow-hidden pt-40 pb-20 md:pt-48 md:pb-24">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
    <img
      src="/brand/isotipo.webp"
      alt=""
      width="256"
      height="282"
      class="pointer-events-none absolute -right-16 -bottom-20 h-80 w-auto opacity-[0.06] brightness-0 invert"
    />

    <div class="wrap relative"><div class="max-w-3xl">
      <p class="eyebrow eyebrow-light reveal">{site.tagline}</p>
      <h1 class="reveal mt-5 text-[clamp(2rem,5vw,3.4rem)] leading-[1.1] font-extrabold" data-retraso="60">
        Quiénes somos
      </h1>
      <p class="reveal mt-6 text-[1.05rem] leading-relaxed text-navy-100" data-retraso="120">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
        magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.
      </p>
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section class="wrap py-20 md:py-28">
    <div class="grid gap-14 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow reveal">Nuestra historia</p>
        <h2 class="reveal mt-5 text-[clamp(1.6rem,3.4vw,2.3rem)] leading-tight font-extrabold" data-retraso="60">
          Texto pendiente de redacción
        </h2>
        <div class="mt-7 space-y-5">
          {
            [
              'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.',
              'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.',
              'Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam eaque ipsa quae ab illo inventore veritatis.',
            ].map((p, i) => (
              <p class="reveal text-[1.02rem] leading-[1.75] text-slate-body" data-retraso={i * 60}>
                {p}
              </p>
            ))
          }
        </div>
      </div>

      <!-- Misión y visión -->
      <div class="space-y-5">
        {
          [
            ['Misión', 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim.'],
            ['Visión', 'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat duis aute.'],
          ].map(([t, d], i) => (
            <div class="card reveal p-7" data-retraso={i * 80}>
              <h3 class="text-[1.05rem] font-bold">{t}</h3>
              <p class="mt-3 leading-relaxed text-slate-body">{d}</p>
            </div>
          ))
        }

        <div class="reveal rounded-[1rem] border border-dashed border-navy-200 bg-navy-50/45 p-7" data-retraso="160">
          <p class="text-[0.8rem] font-semibold tracking-wide text-navy-500 uppercase">Nota interna</p>
          <p class="mt-2.5 text-[0.9rem] leading-relaxed text-slate-body">
            Esta sección espera el texto definitivo de Andrea y Gustavo: historia, misión, visión y cifras reales de
            trayectoria.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="bg-slate-bg py-20 md:py-28">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow reveal justify-center">Cómo trabajamos</p>
        <h2 class="reveal mt-5 text-[clamp(1.6rem,3.4vw,2.3rem)] font-extrabold" data-retraso="60">Nuestros valores</h2>
      </div>

      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          valores.map(([t, d], i) => (
            <div class="card reveal p-7" data-retraso={i * 70}>
              <span class="font-display block text-sm font-extrabold text-gold-500">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 text-[1.02rem] font-bold">{t}</h3>
              <p class="mt-2.5 text-[0.9rem] leading-relaxed text-slate-body">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section class="wrap py-20 md:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow reveal justify-center">El equipo</p>
      <h2 class="reveal mt-5 text-[clamp(1.6rem,3.4vw,2.3rem)] font-extrabold" data-retraso="60">
        Quienes acompañan cada proyecto
      </h2>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        equipo.map((p, i) => (
          <article class="card reveal group overflow-hidden text-center" data-retraso={i * 80}>
            {/* ⚠ PENDIENTE: fotografías reales */}
            <div class="relative grid aspect-square place-items-end overflow-hidden bg-gradient-to-b from-navy-50 to-navy-100">
              <svg class="h-[82%] w-auto text-navy-200 transition-colors duration-300 group-hover:text-navy-300" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
                <circle cx="50" cy="34" r="20" />
                <path d="M50 60c-19 0-34 13-34 29v11h68V89c0-16-15-29-34-29z" />
              </svg>
              <span class="absolute top-3 right-3 rounded-full bg-white/85 px-2.5 py-1 text-[0.62rem] font-semibold tracking-wide text-slate-muted uppercase backdrop-blur-sm">
                Foto pendiente
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-[0.98rem] leading-snug font-bold">{p.nombre}</h3>
              <p class="mt-1.5 text-[0.85rem] text-slate-muted">{p.cargo}</p>
              <p class="mt-3 text-[0.82rem] leading-relaxed text-slate-body">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod.
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</Base>
