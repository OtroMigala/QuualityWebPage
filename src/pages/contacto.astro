---
import Base from '../layouts/Base.astro';
import { site, whatsappUrl } from '../data/site';
import { lineas, areas, rutaArea } from '../data/servicios';
import { ruta } from '../lib/rutas';
---

<Base
  titulo="Contacto"
  descripcion={`Consultoría en sistemas de gestión en ${site.ciudad} y todo Colombia. Diagnóstico inicial sin costo. Escríbanos o llámenos.`}
>
  <!-- Encabezado -->
  <section class="surface-navy relative overflow-hidden pt-40 pb-20 md:pt-48 md:pb-24">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative"><div class="max-w-3xl">
      <h1 class="reveal text-[clamp(2rem,5vw,3.4rem)] leading-[1.1] font-extrabold" data-retraso="60">
        Cuéntenos qué necesita su organización
      </h1>
      <p class="reveal mt-6 text-[1.05rem] leading-relaxed text-navy-100" data-retraso="120">
        La primera conversación es un diagnóstico sin costo. Escuchamos su situación y le decimos con franqueza si
        podemos ayudar, cómo y en qué plazo.
      </p>
      </div>
    </div>
  </section>

  <section class="wrap py-20 md:py-24">
    <div class="grid gap-14 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
      <!-- Formulario -->
      <div>
        <h2 class="reveal text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">Escríbanos</h2>
        <p class="reveal mt-3 text-[0.95rem] text-slate-muted">
          Respondemos dentro del siguiente día hábil.
        </p>

        <form id="form-contacto" class="reveal mt-9 space-y-5" novalidate data-retraso="80">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="nombre" class="mb-2 block text-[0.85rem] font-semibold text-slate-ink">
                Nombre completo <span class="text-gold-600">*</span>
              </label>
              <input
                id="nombre"
                name="nombre"
                type="text"
                required
                class="w-full rounded-xl border border-slate-line px-4 py-3 text-[0.94rem] transition-colors outline-none focus:border-navy-500 focus:ring-4 focus:ring-navy-100"
              />
            </div>
            <div>
              <label for="organizacion" class="mb-2 block text-[0.85rem] font-semibold text-slate-ink">
                Organización
              </label>
              <input
                id="organizacion"
                name="organizacion"
                type="text"
                class="w-full rounded-xl border border-slate-line px-4 py-3 text-[0.94rem] transition-colors outline-none focus:border-navy-500 focus:ring-4 focus:ring-navy-100"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="correo" class="mb-2 block text-[0.85rem] font-semibold text-slate-ink">
                Correo electrónico <span class="text-gold-600">*</span>
              </label>
              <input
                id="correo"
                name="correo"
                type="email"
                required
                class="w-full rounded-xl border border-slate-line px-4 py-3 text-[0.94rem] transition-colors outline-none focus:border-navy-500 focus:ring-4 focus:ring-navy-100"
              />
            </div>
            <div>
              <label for="telefono" class="mb-2 block text-[0.85rem] font-semibold text-slate-ink">Teléfono</label>
              <input
                id="telefono"
                name="telefono"
                type="tel"
                inputmode="tel"
                class="w-full rounded-xl border border-slate-line px-4 py-3 text-[0.94rem] transition-colors outline-none focus:border-navy-500 focus:ring-4 focus:ring-navy-100"
              />
            </div>
          </div>

          <div>
            <label for="interes" class="mb-2 block text-[0.85rem] font-semibold text-slate-ink">
              ¿En qué podemos ayudarle?
            </label>
            <select
              id="interes"
              name="interes"
              class="w-full rounded-xl border border-slate-line bg-white px-4 py-3 text-[0.94rem] transition-colors outline-none focus:border-navy-500 focus:ring-4 focus:ring-navy-100"
            >
              <option value="">Seleccione una opción</option>
              <optgroup label="Consultoría organizacional">
                {areas.map((a) => <option value={a.slug}>{a.tituloCorto}</option>)}
              </optgroup>
              <optgroup label="Otras líneas">
                {
                  lineas
                    .filter((l) => l.slug !== 'consultoria-organizacional')
                    .map((l) => <option value={l.slug}>{l.tituloCorto}</option>)
                }
                <option value="otro">Otro</option>
              </optgroup>
            </select>
          </div>

          <div>
            <label for="mensaje" class="mb-2 block text-[0.85rem] font-semibold text-slate-ink">
              Mensaje <span class="text-gold-600">*</span>
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="5"
              required
              placeholder="Cuéntenos brevemente el contexto de su organización y qué está buscando."
              class="w-full resize-y rounded-xl border border-slate-line px-4 py-3 text-[0.94rem] transition-colors outline-none focus:border-navy-500 focus:ring-4 focus:ring-navy-100"
            ></textarea>
          </div>

          <label class="flex items-start gap-3 text-[0.85rem] leading-relaxed text-slate-body">
            <input
              type="checkbox"
              name="habeas"
              required
              class="mt-0.5 size-4 shrink-0 rounded border-slate-line text-navy-600 focus:ring-navy-200"
            />
            <span>
              Autorizo el tratamiento de mis datos personales conforme a la
              <a href={ruta('/politica-de-privacidad')} class="font-semibold text-navy-600 underline underline-offset-2">
                política de privacidad
              </a>. <span class="text-gold-600">*</span>
            </span>
          </label>

          <button type="submit" class="btn btn-gold w-full sm:w-auto">
            Enviar mensaje
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </button>

          <p id="aviso-form" role="status" class="hidden rounded-xl bg-navy-50 p-4 text-[0.88rem] text-navy-700"></p>
        </form>
      </div>

      <!-- Datos de contacto -->
      <aside class="space-y-5">
        {
          site.contactos.map((c, i) => (
            <div class="card reveal p-7" data-retraso={i * 70}>
              <span class="font-display grid size-12 place-items-center rounded-xl bg-navy-600 text-[0.95rem] font-extrabold text-white">
                {c.nombre.split(' ').slice(0, 2).map((n) => n[0]).join('')}
              </span>
              <h3 class="mt-4 text-[1rem] leading-snug font-bold">{c.nombre}</h3>
              <p class="mt-1 text-[0.85rem] text-slate-muted">{c.cargo}</p>

              <div class="mt-5 space-y-2.5 border-t border-slate-line pt-5">
                <a href={`tel:${c.telefono.replace(/\s/g, '')}`} class="flex items-center gap-2.5 text-[0.9rem] text-slate-body transition-colors hover:text-navy-600">
                  <svg class="size-4 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
                  </svg>
                  {c.telefono}
                </a>
                <a href={`mailto:${c.email}`} class="flex items-center gap-2.5 text-[0.9rem] break-all text-slate-body transition-colors hover:text-navy-600">
                  <svg class="size-4 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m2 7 10 6 10-6" />
                  </svg>
                  {c.email}
                </a>
              </div>

              <a href={whatsappUrl(c.telefonoLimpio)} target="_blank" rel="noopener" class="btn btn-outline mt-5 w-full !py-2.5 text-[0.85rem]">
                Escribir por WhatsApp
              </a>
            </div>
          ))
        }

        <div class="card reveal p-7" data-retraso="140">
          <h3 class="text-[1rem] font-bold">Dónde estamos</h3>
          <p class="mt-3.5 flex items-start gap-2.5 text-[0.9rem] leading-relaxed text-slate-body">
            <svg class="mt-0.5 size-4 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>{site.ciudad}<br /><span class="text-slate-muted">{site.cobertura}</span></span>
          </p>
          <p class="mt-3.5 flex items-start gap-2.5 text-[0.9rem] leading-relaxed text-slate-body">
            <svg class="mt-0.5 size-4 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" />
            </svg>
            {site.horario}
          </p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement;
  const aviso = document.getElementById('aviso-form')!;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Maqueta: aún no hay servicio de envío conectado.
    aviso.className = 'rounded-xl bg-navy-50 p-4 text-[0.88rem] text-navy-700';
    aviso.textContent =
      'Maqueta de demostración: el formulario todavía no envía correos. Falta conectar el servicio de envío (por ejemplo Resend o Formspree) para que los mensajes lleguen a la bandeja de Andrea.';
  });
</script>
