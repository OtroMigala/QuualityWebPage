---
import Base from '../../layouts/Base.astro';
import { cursos } from '../../data/cursos';
import { ruta } from '../../lib/rutas';

/**
 * MAQUETA del panel del estudiante.
 * Los datos de avance son simulados: en producción vendrían de la base de datos
 * del usuario autenticado. Sirve para validar la experiencia antes de construir el backend.
 */
const inscritos = [
  { curso: cursos[0], avance: 68, ultima: 'Módulo 4 · Técnicas de auditoría', leccion: 22, total: 40 },
  { curso: cursos[1], avance: 24, ultima: 'Módulo 2 · Política y objetivos', leccion: 9, total: 40 },
  { curso: cursos[3], avance: 100, ultima: 'Curso completado', leccion: 29, total: 29 },
];

const completados = inscritos.filter((i) => i.avance === 100);
const enCurso = inscritos.filter((i) => i.avance < 100);
const horasTotales = inscritos.reduce((n, i) => n + Math.round((i.curso.duracionHoras * i.avance) / 100), 0);
---

<Base titulo="Mi aprendizaje" descripcion="Panel del estudiante del Aula Virtual Quality." noindex>
  <!-- Encabezado -->
  <section class="surface-navy relative overflow-hidden pt-36 pb-14 md:pt-44 md:pb-16">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>

    <div class="wrap relative mb-9">
      <p class="inline-flex items-center gap-2 rounded-full border border-gold-400/40 bg-gold-400/12 px-4 py-1.5 text-[0.78rem] font-semibold text-gold-300">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 8v5m0 3h.01" />
        </svg>
        Maqueta de demostración · datos simulados
      </p>
    </div>

    <div class="wrap relative flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="flex items-center gap-5">
        <span class="font-display grid size-16 shrink-0 place-items-center rounded-2xl bg-gold-400 text-2xl font-extrabold text-navy-900">
          AU
        </span>
        <div>
          <p class="text-[0.82rem] text-navy-200">Bienvenida de nuevo,</p>
          <h1 class="mt-1 text-[clamp(1.5rem,3.4vw,2.2rem)] leading-tight font-extrabold">Andrea Urbano</h1>
        </div>
      </div>

      <dl class="grid grid-cols-3 gap-8">
        {
          [
            [String(enCurso.length), 'en curso'],
            [String(completados.length), 'completados'],
            [`${horasTotales} h`, 'acumuladas'],
          ].map(([v, e]) => (
            <div>
              <dt class="font-display text-2xl font-extrabold text-gold-400 md:text-3xl">{v}</dt>
              <dd class="mt-1 text-[0.8rem] text-navy-200">{e}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Continuar -->
  <section class="wrap py-14 md:py-20">
    <h2 class="reveal text-[clamp(1.3rem,2.6vw,1.75rem)] font-extrabold">Continuar donde quedó</h2>

    <div class="mt-8 space-y-4">
      {
        enCurso.map((item, i) => (
          <article class="card reveal grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-center" data-retraso={i * 70}>
            <div>
              <p class="text-[0.75rem] font-semibold tracking-wide text-gold-600 uppercase">{item.curso.categoria}</p>
              <h3 class="mt-2 text-[1.08rem] leading-snug font-bold">
                <a href={ruta(`/aula/${item.curso.slug}`)} class="transition-colors hover:text-navy-600">
                  {item.curso.titulo}
                </a>
              </h3>
              <p class="mt-2 text-[0.88rem] text-slate-muted">{item.ultima}</p>

              <div class="mt-5 flex items-center gap-4">
                <div class="h-2 flex-1 overflow-hidden rounded-full bg-slate-line">
                  <div
                    class="h-full rounded-full bg-gradient-to-r from-navy-500 to-gold-400 transition-[width] duration-1000"
                    style={`width:${item.avance}%`}
                  />
                </div>
                <span class="shrink-0 text-[0.82rem] font-semibold text-navy-600">{item.avance}%</span>
              </div>
              <p class="mt-2 text-[0.78rem] text-slate-muted">
                Lección {item.leccion} de {item.total}
              </p>
            </div>

            <a href={ruta(`/aula/${item.curso.slug}`)} class="btn btn-navy shrink-0">
              Continuar
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Certificados -->
  <section class="bg-slate-bg py-14 md:py-20">
    <div class="wrap">
      <h2 class="reveal text-[clamp(1.3rem,2.6vw,1.75rem)] font-extrabold">Mis certificados</h2>

      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          completados.map((item, i) => (
            <article class="card reveal overflow-hidden" data-retraso={i * 70}>
              <div class="surface-navy relative flex h-32 items-center justify-center overflow-hidden">
                <div class="grid-lines absolute inset-0" aria-hidden="true" />
                <svg class="relative size-12 text-gold-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                  <circle cx="12" cy="9" r="6" />
                  <path d="m8.5 14.5-1 7 4.5-2.5 4.5 2.5-1-7" />
                </svg>
              </div>
              <div class="p-6">
                <h3 class="text-[0.98rem] leading-snug font-bold">{item.curso.titulo}</h3>
                <p class="mt-2 text-[0.8rem] text-slate-muted">
                  Emitido el 14 de marzo de 2026 · {item.curso.duracionHoras} horas
                </p>
                <p class="mt-3 font-mono text-[0.75rem] text-navy-500">QCG-2026-0{i + 1}47-AU</p>
                <div class="mt-5 flex gap-2.5">
                  <button type="button" class="btn btn-outline flex-1 !px-4 !py-2.5 text-[0.82rem]">
                    Descargar
                  </button>
                  <button type="button" class="btn btn-outline flex-1 !px-4 !py-2.5 text-[0.82rem]">
                    Verificar
                  </button>
                </div>
              </div>
            </article>
          ))
        }

        <a
          href={ruta('/aula')}
          class="reveal grid place-items-center rounded-[1rem] border border-dashed border-navy-200 bg-white p-8 text-center transition-colors hover:border-navy-400 hover:bg-navy-50/40"
          data-retraso={completados.length * 70}
        >
          <span>
            <svg class="mx-auto size-8 text-navy-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            <span class="mt-3 block text-[0.92rem] font-semibold text-navy-600">Explorar más cursos</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Materiales -->
  <section class="wrap py-14 md:py-20">
    <h2 class="reveal text-[clamp(1.3rem,2.6vw,1.75rem)] font-extrabold">Material descargable</h2>
    <p class="reveal mt-3 text-[0.94rem] text-slate-muted">
      Formatos y matrices incluidos en los cursos que tiene activos.
    </p>

    <ul class="mt-8 divide-y divide-slate-line overflow-hidden rounded-2xl border border-slate-line bg-white">
      {
        [
          ['Lista de verificación ISO 9001:2015', 'XLSX · 84 KB'],
          ['Formato de plan de auditoría', 'DOCX · 41 KB'],
          ['Matriz de peligros GTC 45', 'XLSX · 126 KB'],
          ['Informe de auditoría — plantilla', 'DOCX · 58 KB'],
        ].map(([nombre, meta]) => (
          <li class="flex items-center gap-4 p-5 transition-colors hover:bg-slate-bg">
            <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-navy-50 text-navy-600">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <path d="M14 3v5h5" />
              </svg>
            </span>
            <span class="flex-1">
              <span class="block text-[0.94rem] font-semibold text-slate-ink">{nombre}</span>
              <span class="block text-[0.78rem] text-slate-muted">{meta}</span>
            </span>
            <button type="button" class="text-[0.85rem] font-semibold text-navy-600 transition-colors hover:text-gold-500">
              Descargar
            </button>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
