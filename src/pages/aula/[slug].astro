---
import Base from '../../layouts/Base.astro';
import { cursos, formatoCOP } from '../../data/cursos';

export function getStaticPaths() {
  return cursos.map((curso) => ({ params: { slug: curso.slug }, props: { curso } }));
}

const { curso } = Astro.props;
const totalLecciones = curso.temario.reduce((n, m) => n + m.lecciones, 0);
const relacionados = cursos.filter((c) => c.slug !== curso.slug && c.categoria === curso.categoria).slice(0, 2);
---

<Base titulo={curso.titulo} descripcion={curso.resumen}>
  <!-- Encabezado -->
  <section class="surface-navy relative overflow-hidden pt-36 pb-16 md:pt-44 md:pb-20">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>

    <div class="wrap relative grid gap-12 lg:grid-cols-[1.55fr_1fr] lg:gap-16">
      <div>
        <nav aria-label="Ruta de navegación" class="reveal mb-7 flex flex-wrap items-center gap-2 text-[0.82rem] text-navy-200">
          <a href="/" class="transition-colors hover:text-gold-300">Inicio</a>
          <span aria-hidden="true">/</span>
          <a href="/aula" class="transition-colors hover:text-gold-300">Aula Virtual</a>
          <span aria-hidden="true">/</span>
          <span class="text-white">{curso.categoria}</span>
        </nav>

        <div class="reveal flex flex-wrap gap-2.5">
          <span class="rounded-full bg-white/12 px-3.5 py-1.5 text-[0.75rem] font-semibold text-white backdrop-blur-sm">
            {curso.categoria}
          </span>
          <span class="rounded-full bg-white/12 px-3.5 py-1.5 text-[0.75rem] font-semibold text-white backdrop-blur-sm">
            Nivel {curso.nivel}
          </span>
          <span class="rounded-full bg-white/12 px-3.5 py-1.5 text-[0.75rem] font-semibold text-white backdrop-blur-sm">
            {curso.modalidad}
          </span>
        </div>

        <h1 class="reveal mt-6 text-[clamp(1.8rem,4.4vw,3rem)] leading-[1.12] font-extrabold" data-retraso="60">
          {curso.titulo}
        </h1>
        <p class="reveal mt-6 max-w-2xl text-[1.05rem] leading-relaxed text-navy-100" data-retraso="120">
          {curso.resumen}
        </p>

        <dl class="reveal mt-10 flex flex-wrap gap-x-10 gap-y-5" data-retraso="180">
          {
            [
              [`${curso.duracionHoras} h`, 'intensidad'],
              [String(curso.temario.length), 'módulos'],
              [String(totalLecciones), 'lecciones'],
            ].map(([v, e]) => (
              <div>
                <dt class="font-display text-2xl font-extrabold text-gold-400">{v}</dt>
                <dd class="mt-1 text-[0.8rem] text-navy-200">{e}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Tarjeta de compra -->
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="reveal rounded-2xl border border-white/15 bg-white p-7 shadow-2xl shadow-black/25">
          {
            curso.proximamente ? (
              <>
                <p class="font-display text-2xl font-extrabold text-navy-600">Próximamente</p>
                <p class="mt-2.5 text-[0.9rem] leading-relaxed text-slate-body">
                  Este curso está en preparación. Déjenos su correo y le avisamos cuando abra inscripciones.
                </p>
                <form class="mt-6 space-y-3" data-formulario="aviso">
                  <label for="correo-aviso" class="sr-only">Correo electrónico</label>
                  <input
                    id="correo-aviso"
                    type="email"
                    required
                    placeholder="correo@empresa.com"
                    class="w-full rounded-xl border border-slate-line px-4 py-3 text-[0.92rem] outline-none focus:border-navy-500"
                  />
                  <button type="submit" class="btn btn-navy w-full">Avisarme</button>
                </form>
              </>
            ) : (
              <>
                <div class="flex items-end gap-3">
                  <p class="font-display text-3xl font-extrabold text-navy-600">{formatoCOP(curso.precio)}</p>
                  {curso.precioAntes && (
                    <p class="pb-1.5 text-[0.95rem] text-slate-muted line-through">{formatoCOP(curso.precioAntes)}</p>
                  )}
                </div>
                {curso.precioAntes && (
                  <p class="mt-2 inline-block rounded-full bg-gold-100 px-3 py-1 text-[0.75rem] font-bold text-gold-700">
                    Ahorre {formatoCOP(curso.precioAntes - curso.precio)}
                  </p>
                )}

                <button type="button" class="btn btn-gold mt-6 w-full" data-accion="inscribir">
                  Inscribirme ahora
                </button>
                <a href="/contacto" class="btn btn-outline mt-3 w-full">Cotizar para mi equipo</a>

                <ul class="mt-7 space-y-3 border-t border-slate-line pt-6">
                  {[
                    'Acceso permanente, sin vencimiento',
                    'Certificado con código verificable',
                    'Material descargable incluido',
                    'Pago con tarjeta, PSE o Nequi',
                  ].map((t) => (
                    <li class="flex gap-2.5 text-[0.88rem] text-slate-body">
                      <svg class="mt-0.5 size-4 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
                        <path d="m5 13 4 4L19 7" />
                      </svg>
                      {t}
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </div>
      </aside>
    </div>
  </section>

  <!-- Contenido -->
  <section class="wrap py-20 md:py-24">
    <div class="max-w-3xl">
      <h2 class="reveal text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">Lo que va a aprender</h2>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2">
        {
          curso.aprendizajes.map((a, i) => (
            <li class="reveal flex gap-3" data-retraso={i * 55}>
              <svg class="mt-0.5 size-5 shrink-0 text-gold-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m5 13 4 4L19 7" />
              </svg>
              <span class="text-[0.94rem] leading-relaxed text-slate-body">{a}</span>
            </li>
          ))
        }
      </ul>

      <h2 class="reveal mt-16 text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">Temario</h2>
      <p class="reveal mt-3 text-[0.92rem] text-slate-muted">
        {curso.temario.length} módulos · {totalLecciones} lecciones · {curso.duracionHoras} horas
      </p>

      <div class="mt-7 divide-y divide-slate-line overflow-hidden rounded-2xl border border-slate-line">
        {
          curso.temario.map((m, i) => (
            <details class="group bg-white" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center gap-4 p-5 transition-colors hover:bg-slate-bg">
                <span class="font-display grid size-9 shrink-0 place-items-center rounded-lg bg-navy-50 text-[0.85rem] font-extrabold text-navy-600">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="flex-1">
                  <span class="block text-[0.98rem] leading-snug font-semibold text-slate-ink">{m.titulo}</span>
                  <span class="mt-1 block text-[0.8rem] text-slate-muted">
                    {m.lecciones} lecciones · {m.duracion}
                  </span>
                </span>
                <svg class="size-5 shrink-0 text-slate-muted transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <ul class="space-y-2.5 border-t border-slate-line bg-slate-bg px-5 py-4 pl-[4.25rem]">
                {Array.from({ length: Math.min(m.lecciones, 4) }, (_, j) => (
                  <li class="flex items-center gap-2.5 text-[0.88rem] text-slate-body">
                    <svg class="size-4 shrink-0 text-navy-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" />
                      <path d="m10 8 6 4-6 4z" />
                    </svg>
                    Lección {i + 1}.{j + 1} — contenido por definir
                  </li>
                ))}
                {m.lecciones > 4 && (
                  <li class="pt-1 text-[0.82rem] text-slate-muted">+ {m.lecciones - 4} lecciones más</li>
                )}
              </ul>
            </details>
          ))
        }
      </div>

      <h2 class="reveal mt-16 text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">¿A quién está dirigido?</h2>
      <p class="reveal mt-5 text-[1.02rem] leading-[1.75] text-slate-body">{curso.dirigidoA}</p>

      <div class="reveal mt-10 flex gap-4 rounded-2xl border border-gold-200 bg-gold-50 p-6">
        <svg class="size-6 shrink-0 text-gold-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="9" r="6" />
          <path d="m8.5 14.5-1 7 4.5-2.5 4.5 2.5-1-7" />
        </svg>
        <div>
          <h3 class="text-[1rem] font-bold">Certificación</h3>
          <p class="mt-2 text-[0.92rem] leading-relaxed text-slate-body">{curso.certificado}</p>
        </div>
      </div>
    </div>
  </section>

  {
    relacionados.length > 0 && (
      <section class="bg-slate-bg py-20 md:py-24">
        <div class="wrap">
          <h2 class="reveal text-[clamp(1.4rem,2.8vw,1.9rem)] font-extrabold">También en {curso.categoria}</h2>
          <div class="mt-10 grid gap-5 md:grid-cols-2">
            {relacionados.map((c, i) => (
              <a href={`/aula/${c.slug}`} class="card reveal p-7" data-retraso={i * 70}>
                <p class="text-[0.75rem] font-semibold tracking-wide text-gold-600 uppercase">{c.nivel}</p>
                <h3 class="mt-2 text-[1.05rem] leading-snug font-bold">{c.titulo}</h3>
                <p class="mt-3 text-[0.9rem] leading-relaxed text-slate-body">{c.resumen}</p>
                <p class="font-display mt-5 text-lg font-extrabold text-navy-600">
                  {c.proximamente ? 'Próximamente' : formatoCOP(c.precio)}
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Maqueta: la pasarela de pago aún no está conectada.
  document.querySelector('[data-accion="inscribir"]')?.addEventListener('click', () => {
    alert(
      'Maqueta de demostración.\n\nAquí se abrirá el pago (tarjeta, PSE o Nequi) y al confirmarse se dará acceso inmediato al curso.'
    );
  });

  document.querySelector('[data-formulario="aviso"]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Maqueta de demostración.\n\nEl correo quedará registrado para avisarle cuando abran inscripciones.');
  });
</script>
