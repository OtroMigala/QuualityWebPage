---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ServicioIcono from '../components/ServicioIcono.astro';
import CursoCard from '../components/CursoCard.astro';
import { site } from '../data/site';
import { servicios } from '../data/servicios';
import { cursos } from '../data/cursos';
import { ruta } from '../lib/rutas';

const destacados = cursos.filter((c) => c.destacado).slice(0, 3);

const diferenciales = [
  {
    titulo: 'Consultores que auditan',
    texto:
      'Nuestro equipo audita en el día a día. Sabemos qué pregunta un verificador y qué evidencia resiste una revisión, porque estamos del otro lado de la mesa con frecuencia.',
  },
  {
    titulo: 'Transferencia, no dependencia',
    texto:
      'El objetivo declarado de cada acompañamiento es que su equipo pueda sostener el sistema sin nosotros. Formamos, documentamos y nos hacemos a un lado.',
  },
  {
    titulo: 'Sobre su operación real',
    texto:
      'No entregamos plantillas genéricas. Partimos de los procesos que usted ya tiene y los ordenamos, en lugar de imponer una estructura que nadie va a seguir.',
  },
  {
    titulo: 'Presencial y virtual',
    texto:
      'Con base en Popayán y trabajo en todo el país. Combinamos visitas en sitio con acompañamiento remoto para que el costo no se vaya en desplazamientos.',
  },
];

// ⚠ PENDIENTE: equipo real. Fotos e información de marcador de posición.
const equipo = [
  { nombre: 'Andrea Cecilia Urbano Gallego', cargo: 'Dirección de Consultoría', semilla: 'andrea' },
  { nombre: 'Gustavo Adolfo Ramírez González', cargo: 'Dirección de Formación', semilla: 'gustavo' },
  { nombre: 'Nombre por definir', cargo: 'Consultoría en Salud', semilla: 'consultor3' },
  { nombre: 'Nombre por definir', cargo: 'Auditoría y Riesgos', semilla: 'consultor4' },
];
---

<Base titulo={site.nombre} headerTransparente>
  <Hero />

  <!-- ============ SERVICIOS ============ -->
  <section id="servicios" class="wrap scroll-mt-28 py-20 md:py-28">
    <div class="max-w-2xl">
      <h2 class="reveal text-[clamp(1.7rem,4vw,2.7rem)] leading-tight font-extrabold" data-retraso="60">
        Cinco líneas de trabajo, un mismo criterio
      </h2>
      <p class="reveal mt-5 text-[1.02rem] leading-relaxed" data-retraso="120">
        Cada acompañamiento empieza por entender qué está en juego en su organización. A partir de ahí definimos
        alcance, tiempos y entregables, sin paquetes cerrados.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        servicios.map((s, i) => (
          <a
            href={ruta(`/servicios/${s.slug}`)}
            class="card reveal group relative flex flex-col overflow-hidden p-7"
            data-retraso={i * 70}
          >
            <span class="grid size-12 place-items-center rounded-xl bg-navy-50 text-navy-600 transition-colors duration-300 group-hover:bg-navy-600 group-hover:text-gold-400">
              <ServicioIcono nombre={s.icono} clase="size-6" />
            </span>

            <h3 class="mt-5 text-[1.05rem] leading-snug font-bold">{s.tituloCorto}</h3>
            <p class="mt-1.5 text-[0.78rem] font-semibold tracking-wide text-gold-600 uppercase">{s.tagline}</p>
            <p class="mt-3.5 flex-1 text-[0.9rem] leading-relaxed text-slate-body">{s.resumen}</p>

            <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-navy-600">
              Conocer más
              <svg
                class="size-4 transition-transform duration-300 group-hover:translate-x-1"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }

      <!-- Tarjeta de eventos: pendiente de definir con Gustavo -->
      <div class="reveal relative flex flex-col justify-between overflow-hidden rounded-[1rem] border border-dashed border-navy-200 bg-navy-50/45 p-7" data-retraso={servicios.length * 70}>
        <div>
          <span class="grid size-12 place-items-center rounded-xl bg-white text-navy-600">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4m-6 8h4" />
            </svg>
          </span>
          <h3 class="mt-5 text-[1.05rem] leading-snug font-bold">Convenciones y eventos comerciales</h3>
          <p class="mt-3.5 text-[0.9rem] leading-relaxed text-slate-body">
            Organización de encuentros empresariales, jornadas técnicas y convenciones.
          </p>
        </div>
        <p class="mt-6 text-[0.8rem] font-semibold text-navy-500">Sección en construcción</p>
      </div>
    </div>
  </section>

  <!-- ============ AULA VIRTUAL ============ -->
  <section class="surface-navy relative overflow-hidden py-20 md:py-28">
    <div class="grid-lines absolute inset-0" aria-hidden="true"></div>

    <div class="wrap relative">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <h2 class="reveal text-[clamp(1.7rem,4vw,2.7rem)] leading-tight font-extrabold" data-retraso="60">
            Aula Virtual Quality
          </h2>
          <p class="reveal mt-5 text-[1.02rem] leading-relaxed text-navy-100" data-retraso="120">
            Formación con la misma exigencia técnica de nuestra consultoría. Cursos autogestionados y programas con
            acompañamiento, con certificado al finalizar.
          </p>
        </div>
        <a href={ruta('/aula')} class="btn btn-gold reveal shrink-0" data-retraso="180">Ver todos los cursos</a>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {destacados.map((c, i) => <CursoCard curso={c} retraso={i * 80} />)}
      </div>

      <ul class="reveal mt-14 grid gap-5 border-t border-white/12 pt-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            ['Acceso permanente', 'El curso queda disponible sin fecha de vencimiento.'],
            ['Certificado verificable', 'Con código único y validación en línea.'],
            ['Material descargable', 'Formatos, matrices y listas de verificación listas para usar.'],
            ['Avance a su ritmo', 'La plataforma recuerda dónde quedó en cada lección.'],
          ].map(([t, d]) => (
            <li class="border-l-2 border-gold-400/45 pl-4">
              <p class="text-[0.92rem] font-semibold text-white">{t}</p>
              <p class="mt-1 text-[0.85rem] leading-relaxed text-navy-200">{d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ POR QUÉ NOSOTROS ============ -->
  <section class="wrap py-20 md:py-28">
    <div class="grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div>
        <h2 class="reveal text-[clamp(1.7rem,4vw,2.7rem)] leading-tight font-extrabold" data-retraso="60">
          La diferencia está en cómo trabajamos
        </h2>
        <p class="reveal mt-5 leading-relaxed" data-retraso="120">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore
          magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation.
        </p>
        <a href={ruta('/nosotros')} class="btn btn-outline reveal mt-8" data-retraso="180">Conocer la empresa</a>
      </div>

      <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
        {
          diferenciales.map((d, i) => (
            <li class="reveal" data-retraso={i * 80}>
              <h3 class="text-[1.02rem] font-bold">{d.titulo}</h3>
              <p class="mt-2.5 text-[0.92rem] leading-relaxed text-slate-body">{d.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ PRUEBA SOCIAL ============ -->
  <section class="bg-slate-bg py-20 md:py-28">
    <div class="wrap">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="reveal text-[clamp(1.7rem,4vw,2.7rem)] leading-tight font-extrabold" data-retraso="60">
          Organizaciones que ya dieron el paso
        </h2>
      </div>

      <!-- ⚠ PENDIENTE: logos reales de clientes -->
      <div class="reveal mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6" data-retraso="120">
        {
          Array.from({ length: 6 }, (_, i) => (
            <div class="grid h-20 place-items-center rounded-xl border border-slate-line bg-white">
              <span class="text-[0.7rem] font-semibold tracking-wider text-slate-muted uppercase">
                Cliente {i + 1}
              </span>
            </div>
          ))
        }
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {
          Array.from({ length: 3 }, (_, i) => (
            <figure class="card reveal p-7" data-retraso={i * 90}>
              <blockquote class="text-[0.95rem] leading-relaxed text-slate-body">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et
                dolore magna aliqua. Ut enim ad minim veniam quis nostrud.
              </blockquote>
              <figcaption class="mt-6 flex items-center gap-3 border-t border-slate-line pt-5">
                <span class="grid size-11 place-items-center rounded-full bg-navy-50 font-bold text-navy-600">
                  {['MR', 'JC', 'LP'][i]}
                </span>
                <span>
                  <span class="block text-[0.88rem] font-semibold text-slate-ink">Nombre Apellido</span>
                  <span class="block text-[0.78rem] text-slate-muted">Cargo · Organización</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ EQUIPO ============ -->
  <section class="wrap py-20 md:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="reveal text-[clamp(1.7rem,4vw,2.7rem)] leading-tight font-extrabold" data-retraso="60">
        Quienes acompañan cada proyecto
      </h2>
      <p class="reveal mt-5 leading-relaxed" data-retraso="120">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        equipo.map((p, i) => (
          <article class="reveal group text-center" data-retraso={i * 80}>
            {/* ⚠ PENDIENTE: fotografías reales del equipo */}
            <div class="relative mx-auto grid aspect-square w-full max-w-[15rem] place-items-end overflow-hidden rounded-2xl bg-gradient-to-b from-navy-50 to-navy-100">
              <svg class="h-[82%] w-auto text-navy-200 transition-colors duration-300 group-hover:text-navy-300" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
                <circle cx="50" cy="34" r="20" />
                <path d="M50 60c-19 0-34 13-34 29v11h68V89c0-16-15-29-34-29z" />
              </svg>
              <span class="absolute top-3 right-3 rounded-full bg-white/85 px-2.5 py-1 text-[0.62rem] font-semibold tracking-wide text-slate-muted uppercase backdrop-blur-sm">
                Foto pendiente
              </span>
            </div>
            <h3 class="mt-5 text-[0.98rem] leading-snug font-bold">{p.nombre}</h3>
            <p class="mt-1 text-[0.85rem] text-slate-muted">{p.cargo}</p>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBanner />
</Base>
